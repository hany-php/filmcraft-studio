{
  "name": "filmcraft-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns the videos in a workspace folder into a finished FilmCraft montage from one tool call.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
